# Client-side variables (bundled by Vite — safe to expose)
VITE_SUPABASE_URL=your_supabase_project_url
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key

# Server-side only — used by Vercel API routes (api/*.js)
# NEVER prefix with VITE_ or it will be bundled into client JS
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key
